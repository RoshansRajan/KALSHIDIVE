# Copy to .env and fill in what you need. Everything here is optional --
# with an empty .env the stack runs on synthetic market data.

# ---- LLM analysis -----------------------------------------------------------
# Without this, ingest and persistence run normally and analysis calls fail.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANALYSIS_WINDOW_SECONDS=30

# ---- Live Kalshi feed -------------------------------------------------------
# Both must be set to leave MockFeed behind. Generate an API key in Kalshi's
# account settings; it hands you a key ID and a private key PEM.
# Put the PEM in ./secrets/ (gitignored) and reference it by container path.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/secrets/kalshi-private-key.pem
KALSHI_MARKET_TICKERS=KXBTCD-25AUG26-T100000,KXHIGHNY-25AUG26-T90

# ---- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO
